{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidequest",
  "version": "0.1.0",
  "identifier": "com.xuuuu51.sidequest",
  "build": {
    "beforeDevCommand": "pnpm prepare:integrations:dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prepare:integrations:release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sidequest",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 16
        }
      },
      {
        "label": "quick-capture",
        "title": "Quick Capture",
        "width": 520,
        "height": 300,
        "minWidth": 520,
        "minHeight": 300,
        "maxWidth": 520,
        "maxHeight": 300,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sq": "sq",
      "resources/sidequest-skill/SKILL.md": "sidequest-skill/SKILL.md"
    }
  }
}
